# Скопируйте в .env. Секреты — только здесь/в secret manager, никогда в коде и промптах.
HQ_ENV=dev                                  # dev | test | prod
HQ_DATABASE_URL=sqlite:///./hqteam.db       # prod: postgresql+psycopg://user:${DB_PASSWORD}@host:5432/hqteam
HQ_ARTIFACT_BACKEND=local                   # local | s3
HQ_ARTIFACTS_DIR=./artifacts
HQ_OUTBOX_DIR=./outbox
# HQ_S3_BUCKET=

# LLM: offline — детерминированный режим без сети (тесты/сценарии). live — Anthropic API.
HQ_LLM_MODE=offline
HQ_LLM_MODEL=claude-opus-5-5
HQ_LLM_EFFORT=medium
HQ_LLM_MAX_TOKENS=16000
HQ_LLM_TIMEOUT_S=120
HQ_LLM_MAX_RETRIES=3
HQ_LLM_SERVER_FALLBACKS=true
# Цены $/1M токенов для журнала стоимости — сверить с актуальным прайсом Anthropic
HQ_LLM_PRICE_INPUT_PER_MTOK=4.0
HQ_LLM_PRICE_OUTPUT_PER_MTOK=20.0
# Ключ читается SDK Anthropic из окружения (нужен только при HQ_LLM_MODE=live)
ANTHROPIC_API_KEY=

# Лимиты на задачу
HQ_TASK_MAX_LLM_CALLS=8
HQ_TASK_MAX_COST_USD=2.0
HQ_TASK_MAX_ATTEMPTS=3
HQ_TASK_STALE_MINUTES=240
HQ_LEGAL_SOURCE_MAX_AGE_DAYS=90

# Внешние операции: simulate — пишет в outbox/, ничего не отправляет
HQ_EXTERNAL_SEND_MODE=simulate

# Bootstrap-ключ администратора (dev). В prod — через secret manager и `hqteam principals add`.
HQ_BOOTSTRAP_ADMIN_KEY=
