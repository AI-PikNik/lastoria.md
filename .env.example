# === База данных ===
# PostgreSQL connection string. Локально см. README (docker compose / локальный postgres).
DATABASE_URL="postgresql://lastoria:lastoria@localhost:5432/lastoria?schema=public"

# === Публичный URL сайта (для metadataBase, sitemap, canonical, OG) ===
# Также используется для allowedOrigins Server Actions за обратным прокси (aaPanel/Nginx) — см. README.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# === Порт, на котором слушает "npm run start" (next start) ===
# На aaPanel — порт, который PM2/Node-менеджер прокидывает через reverse proxy Nginx.
PORT=3000

# === NextAuth (только для /admin) ===
# Сгенерировать: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-base64-secret"
AUTH_URL="http://localhost:3000"

# === Учётные данные администратора для сид-скрипта (prisma/seed.ts) ===
ADMIN_EMAIL="admin@lastoria.md"
ADMIN_PASSWORD="change-me-please-123"
ADMIN_NAME="Admin"

# === Почта ===
# EMAIL_PROVIDER: "resend" | "console" (в dev, если ключа нет, письма пишутся в консоль)
EMAIL_PROVIDER="console"
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="La Storia <no-reply@lastoria.md>"
ADMIN_NOTIFICATION_EMAIL="orders@lastoria.md"

# === Telegram-уведомления администратору ===
TELEGRAM_BOT_TOKEN="000000000:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TELEGRAM_ADMIN_CHAT_ID="123456789"

# === Загрузка файлов ===
# UPLOAD_PROVIDER: "local" (по умолчанию, /public/uploads) | "s3" (S3-совместимое хранилище)
UPLOAD_PROVIDER="local"
S3_ENDPOINT="https://s3.eu-central-1.amazonaws.com"
S3_REGION="eu-central-1"
S3_BUCKET="lastoria-uploads"
S3_ACCESS_KEY_ID="replace-with-access-key-id"
S3_SECRET_ACCESS_KEY="replace-with-secret-access-key"
S3_PUBLIC_URL="https://lastoria-uploads.s3.eu-central-1.amazonaws.com"

# === Прочее ===
# Валюта интерфейса (только MDL поддерживается в v1)
NEXT_PUBLIC_CURRENCY="MDL"
