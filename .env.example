# === База данных ===
# PostgreSQL connection string. Локально см. README (docker compose / локальный postgres).
DATABASE_URL="postgresql://lastoria:lastoria@localhost:5432/lastoria?schema=public"

# === Публичный URL сайта (для metadataBase, sitemap, canonical, OG) ===
# Также используется для allowedOrigins Server Actions за обратным прокси (aaPanel/Nginx) — см. README.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# === Порт, на котором слушает "npm run start" (next start) ===
# На aaPanel — порт, который PM2/Node-менеджер прокидывает через reverse proxy Nginx.
PORT=3000

# === NextAuth (только для /admin) ===
# Сгенерировать: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-base64-secret"
AUTH_URL="http://localhost:3000"

# === Учётные данные администратора для сид-скрипта (prisma/seed.ts) ===
ADMIN_EMAIL="admin@lastoria.md"
ADMIN_PASSWORD="change-me-please-123"
ADMIN_NAME="Admin"

# === Почта ===
# EMAIL_PROVIDER: "smtp" (свой почтовый сервер) | "resend" (сервис Resend) | "console" (по умолчанию — письма пишутся в консоль, ничего никуда не отправляется)
EMAIL_PROVIDER="console"
EMAIL_FROM="La Storia <no-reply@lastoria.md>"
ADMIN_NOTIFICATION_EMAIL="orders@lastoria.md"

# --- Вариант "smtp": свой почтовый ящик/сервер (например, почта на вашем хостинге, Яндекс, Mail.ru и т.п.) ---
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="no-reply@lastoria.md"
SMTP_PASSWORD="replace-with-mailbox-password"
# SMTP_SECURE: "true" для порта 465 (SSL с самого начала соединения), для 587/25 оставьте "false" (используется STARTTLS)
SMTP_SECURE="false"

# --- Вариант "resend": облачный сервис отправки почты (нужен аккаунт на resend.com) ---
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# === Telegram-уведомления администратору ===
TELEGRAM_BOT_TOKEN="000000000:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TELEGRAM_ADMIN_CHAT_ID="123456789"

# === Загрузка файлов ===
# UPLOAD_PROVIDER: "local" (по умолчанию и рекомендуется — фото хранятся прямо на
# сервере сайта в /public/uploads, никакие сторонние сервисы не нужны)
# "s3" — необязательная продвинутая опция для S3-совместимого облачного хранилища
UPLOAD_PROVIDER="local"

# --- Заполняйте S3_* только если выбрали UPLOAD_PROVIDER="s3" (необязательно) ---
S3_ENDPOINT="https://s3.eu-central-1.amazonaws.com"
S3_REGION="eu-central-1"
S3_BUCKET="lastoria-uploads"
S3_ACCESS_KEY_ID="replace-with-access-key-id"
S3_SECRET_ACCESS_KEY="replace-with-secret-access-key"
S3_PUBLIC_URL="https://lastoria-uploads.s3.eu-central-1.amazonaws.com"

# === Прочее ===
# Валюта интерфейса (только MDL поддерживается в v1)
NEXT_PUBLIC_CURRENCY="MDL"
