// La Storia — Prisma schema
// docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
}

enum ProductType {
  PIZZA
  DRINK
  ALCOHOL
  OTHER
}

enum PromoType {
  PERCENT
  FIXED
  PRODUCT_OVERRIDE
}

enum PromoScope {
  PRODUCT
  CATEGORY
  PRODUCT_TYPE
  CART
}

enum OrderStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum FulfillmentType {
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  CASH
  CARD_ON_DELIVERY
}

enum OrderSource {
  SITE
}

enum OrderEventActor {
  CUSTOMER
  ADMIN
  SYSTEM
}

enum NotificationChannel {
  TELEGRAM
  EMAIL
}

enum NotificationType {
  NEW_ORDER
  STATUS_CHANGED
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Category {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  description     String?
  sortOrder       Int       @default(0)
  isActive        Boolean   @default(true)
  seoTitle        String?
  seoDescription  String?
  products        Product[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isActive])
  @@map("categories")
}

model Product {
  id               String      @id @default(cuid())
  name             String
  slug             String      @unique
  description      String?
  shortDescription String?
  categoryId       String
  category         Category    @relation(fields: [categoryId], references: [id])
  type             ProductType
  price            Decimal     @db.Decimal(10, 2)
  oldPrice         Decimal?    @db.Decimal(10, 2)
  isAlcohol        Boolean     @default(false)
  isVegetarian     Boolean     @default(false)
  isSpicy          Boolean     @default(false)
  isActive         Boolean     @default(true)
  isFeatured       Boolean     @default(false)
  sku              String?
  sortOrder        Int         @default(0)
  stock            Int?
  imageUrl         String?
  galleryUrls      Json        @default("[]")
  ingredients      Json        @default("[]")
  variants         Json?
  seoTitle         String?
  seoDescription   String?
  seoKeywords      String?
  ogImageUrl       String?
  orderItems       OrderItem[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([type])
  @@index([isActive])
  @@index([isAlcohol])
  @@index([categoryId])
  @@map("products")
}

model Promo {
  id             String     @id @default(cuid())
  name           String
  code           String?    @unique
  type           PromoType
  value          Decimal    @db.Decimal(10, 2)
  scope          PromoScope
  targetIds      Json       @default("[]")
  minOrderAmount Decimal?   @db.Decimal(10, 2)
  startsAt       DateTime
  endsAt         DateTime
  isActive       Boolean    @default(true)
  stackable      Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([isActive])
  @@index([startsAt, endsAt])
  @@map("promos")
}

model Order {
  id             String          @id @default(cuid())
  publicToken    String          @unique @default(cuid())
  status         OrderStatus     @default(PENDING_CONFIRMATION)
  fulfillment    FulfillmentType
  paymentMethod  PaymentMethod   @default(CASH)
  customerName   String
  phone          String
  email          String?
  address        String?
  comment        String?
  subtotal       Decimal         @db.Decimal(10, 2)
  discountTotal  Decimal         @default(0) @db.Decimal(10, 2)
  deliveryFee    Decimal         @default(0) @db.Decimal(10, 2)
  total          Decimal         @db.Decimal(10, 2)
  appliedPromos  Json            @default("[]")
  source         OrderSource     @default(SITE)
  confirmedAt    DateTime?
  cancelledAt    DateTime?
  items          OrderItem[]
  events         OrderEvent[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product? @relation(fields: [productId], references: [id])
  nameSnapshot    String
  variantSnapshot Json?
  qty             Int
  unitPrice       Decimal  @db.Decimal(10, 2)
  lineTotal       Decimal  @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderEvent {
  id         String           @id @default(cuid())
  orderId    String
  order      Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actor      OrderEventActor
  note       String?
  createdAt  DateTime         @default(now())

  @@index([orderId])
  @@map("order_events")
}

model NotificationLog {
  id        String              @id @default(cuid())
  channel   NotificationChannel
  type      NotificationType
  payload   Json
  status    NotificationStatus  @default(QUEUED)
  error     String?
  createdAt DateTime            @default(now())

  @@index([channel])
  @@index([status])
  @@map("notification_logs")
}

model Settings {
  id                    String   @id @default("main")
  restaurantName        String   @default("La Storia")
  restaurantPhone       String   @default("+373 00 000 000")
  restaurantAddress     String   @default("Chișinău, Republica Moldova")
  restaurantEmail       String?
  workingHours          String   @default("10:00–22:00")
  minOrderAmount        Decimal  @default(0) @db.Decimal(10, 2)
  deliveryZones         Json     @default("[]")
  seoDefaultTitle       String   @default("La Storia — pizzerie autentică în Moldova")
  seoDefaultDescription String   @default("Comandă pizza, băuturi și mâncare gata în La Storia. Livrare și ridicare în Chișinău.")
  telegramChatId        String?
  emailSenderAddress    String?
  updatedAt             DateTime @updatedAt

  @@map("settings")
}
